{
  "version": 2,
  "public": true,
  "rewrites": [
    { "source": "/api/news", "destination": "/api/news.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
